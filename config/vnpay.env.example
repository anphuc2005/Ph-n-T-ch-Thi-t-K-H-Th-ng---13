# Load into the environment of Tomcat before starting it. Never commit real credentials.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/cineman/payments/vnpay/return
# Register an HTTPS public IPN URL ending in /cineman/payments/vnpay/ipn with VNPAY.
CINEMAN_UPLOAD_DIR=/absolute/path/outside/webapps/cineman-posters
